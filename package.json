{
  "name": "maya-portfolio",
  "version": "1.0.0",
  "description": "Maya Helmi - portfolio site. Static HTML/CSS/JS; Tailwind compiles css/tailwind.input.css to css/tailwind.css.",
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css",
    "watch:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MayaHelmi/maya-portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/MayaHelmi/maya-portfolio/issues"
  },
  "homepage": "https://github.com/MayaHelmi/maya-portfolio#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "private": true
}
